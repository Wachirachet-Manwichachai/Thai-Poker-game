// Helper: C(suit, rank) builds a card id so examples are readable, e.g. C(0,12) = King of spades.
const C = (suit, rank) => suit * 13 + rank;   // tutorial helper

// Builds ONE example row for the tutorial: example cards + value badge + explanation text.
function tutRow(cards, badge, badgeCls, text) {
  // Outer row container.
  const row = document.createElement('div'); row.className = 'tut-row';
  // Container for the example cards.
  const cc = document.createElement('div'); cc.className = 'tut-cards';
  // Draw each example card with the same cardEl() the game uses.
  cards.forEach(c => cc.appendChild(cardEl(c, false)));
  // The badge element (value label); badgeCls may add the green "good" style.
  const bd = document.createElement('div'); bd.className = 'tut-badge' + (badgeCls ? ' ' + badgeCls : '');
  // Put the label text in the badge.
  bd.textContent = badge;
  // The explanation element.
  const tx = document.createElement('div'); tx.className = 'tut-txt';
  // innerHTML (not textContent) so <b>bold</b> tags in the text work.
  tx.innerHTML = text;
  // Assemble: cards, then badge, then text.
  row.appendChild(cc); row.appendChild(bd); row.appendChild(tx);
  // Give the finished row back.
  return row;
}

