  const close = document.createElement('button');
  // Label it.
  close.textContent = 'Close';
  // Small gap above it.
  close.style.marginTop = '10px';
  // Clicking hides the popup and resets its width style.
  close.onclick = () => { el('msg').style.display = 'none'; box.className = ''; };
  // Add the button.
  box.appendChild(close);
  // Show the popup overlay.
  el('msg').style.display = 'flex';
}

// Opens the simple text Rules popup.
function showRules() {
  // The popup window.
  const box = el('msgBox');
  // Use the normal (narrow) width.
  box.className = '';
  // Fill the popup with the rules text (HTML string joined with +).
  box.innerHTML = '<h2>📖 Pok Deng Rules</h2><div style="text-align:left;font-size:14px;line-height:1.7">' +
  '<p><b>Goal:</b> get a hand value closer to 9 than the Dealer. Everyone plays against the Dealer only.</p>' +
  '<p><b>Value:</b> sum of cards, <b>mod 10</b> (only last digit counts). A=1, 2–9 face value, 10/J/Q/K=0.</p>' +
  '<p><b>Pok:</b> 8 or 9 on your first two cards — instant stand, beats any non-Pok hand!</p>' +
  '<p><b>Turn order:</b> cards are dealt around the table, then You → Somchai → Nok each draw or stay, then the Dealer flips and plays last.</p>' +
  '<p><b>Deng (payout multipliers):</b><br>· 2 cards, pair or same suit → <b>×2</b><br>· 3 cards, flush or straight → <b>×3</b><br>· three of a kind → <b>×5</b></p>' +
  '<p><b>Payout:</b> win → bet × your deng. Lose → bet × dealer deng. Tie → nothing changes.</p>' +
  '<p style="color:#ffd45e"><b>Note:</b> chips are just points for fun — no real money here! 😊</p>' +
  '</div><br><button onclick="document.getElementById(\'msg\').style.display=\'none\'">Close</button>';
  // Show the popup.
  el('msg').style.display = 'flex';
}

